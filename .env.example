BOT_TOKEN=your_telegram_bot_token_here
DB_PATH=bot.db

# Faqat shu Telegram user ID lar admin bo'ladi (vergul bilan ajrating)
ADMIN_USER_IDS=123456789

# Gmail OAuth client JSON file (Google Cloud Console dan olinadi)
GMAIL_CREDENTIALS_FILE=credentials.json

# OAuth token shu faylda saqlanadi (birinchi authdan keyin auto yaratiladi)
GMAIL_TOKEN_FILE=token.json

# Filtrlanadigan sender email (masalan alerts@gmail.com)
SENDER_FILTER=

# Subject ichida bo'lishi shart bo'lgan ibora
SUBJECT_MUST_CONTAIN=New request from

# Ixtiyoriy: bitta guruhni avtomatik qo'shish (legacy qulaylik)
TARGET_CHAT_ID=

# Gmailni nechchi soniyada bir tekshirish
POLL_INTERVAL_SECONDS=15

# Qo'shimcha Gmail query (ixtiyoriy), masalan: "is:unread"
GMAIL_QUERY_EXTRA=

# MsgPlane API — order bo'yicha agentni aniqlash uchun
MSGPLANE_API_KEY=
MSGPLANE_API_URL=https://usst.msgplane.com/api/rest/get/user_by_order_number/
